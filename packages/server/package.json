{
  "name": "@airyschat/mcp",
  "version": "1.0.0",
  "mcpName": "chat.airys/mcp",
  "description": "MCP server for AirysChat \u2014 conversations, contacts, CRM, AI agents, and WhatsApp campaigns for Claude, Codex, Gemini, Antigravity, and any MCP client",
  "type": "module",
  "bin": {
    "airyschat-mcp": "dist/index.js",
    "airyschat-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "catalog.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AirysChat/mcp.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/AirysChat/mcp#readme",
  "bugs": "https://github.com/AirysChat/mcp/issues",
  "scripts": {
    "build": "node ../../scripts/inventory/build-catalog.mjs --stats && tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm build",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "live-verify": "pnpm build && node scripts/live-verify.mjs",
    "test": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/tools/**' --test-coverage-exclude='src/index.ts' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 'test/**/*.test.ts'",
    "catalog": "node ../../scripts/inventory/build-catalog.mjs --stats"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "airyschat",
    "chatwoot",
    "whatsapp",
    "crm"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
