{
  "name": "airyschat-mcp-monorepo",
  "private": true,
  "description": "AirysChat for AI agents: MCP server, agent plugins and skills",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm -r smoke",
    "check": "pnpm typecheck && pnpm smoke && pnpm inventory:check",
    "inventory": "node scripts/inventory/build-inventory.mjs",
    "inventory:check": "node scripts/inventory/build-inventory.mjs --check",
    "changeset": "changeset",
    "release:prepare": "bash scripts/release/prepare.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
